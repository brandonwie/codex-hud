#!/usr/bin/env sh
zero=0000000000000000000000000000000000000000
head=$(git rev-parse HEAD)
checked=0

while read -r local_ref local_sha _; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$(git rev-parse "$local_sha^{commit}")" != "$head" ]; then
    echo "pre-push: $local_ref is not the checked-out HEAD. Check it out and push again, so the checks run on the commit you push." >&2
    exit 1
  fi
  checked=1
done

[ "$checked" = 1 ] || exit 0

if ! status=$(git status --porcelain); then
  echo "pre-push: git status failed, so the hook cannot show that the checks run on the commit you push. Fix the repository and push again." >&2
  exit 1
fi

if [ -n "$status" ]; then
  echo "pre-push: the working tree has uncommitted or untracked files. Commit or remove them, so the checks run on the commit you push." >&2
  exit 1
fi

# The checks run through scripts/run-isolated.sh, as in the Mac gate: no proxy
# variable and none of your Cargo, npm or Git config reach them, so a configured
# value (such as a proxy URL with a password) cannot appear in their output.
# The state directory sits in the Git directory and is reused, so Cargo keeps
# its downloaded crates between pushes.
if ! git_dir=$(git rev-parse --absolute-git-dir); then
  echo "pre-push: git rev-parse failed, so the hook cannot find the Git directory for the check state. Fix the repository and push again." >&2
  exit 1
fi
exec nice -n 10 sh scripts/run-isolated.sh "$git_dir/codex-hud-ci-local" . sh scripts/ci-local.sh
